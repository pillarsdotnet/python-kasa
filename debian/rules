#! /usr/bin/make -f

export PYBUILD_NAME=kasa

include /usr/share/dpkg/buildopts.mk

# The suite imports devtools/, reads its own fixtures and doctests README.md
# and docs/, so it runs from a copy of those in the build directory.
TEST_FILES = tests devtools docs README.md
export PYBUILD_BEFORE_TEST=cd {dir} && cp -r $(TEST_FILES) {build_dir}/
export PYBUILD_AFTER_TEST=cd {build_dir} && rm -rf $(TEST_FILES)

# test_cli_child_commands expects the error message and exit status that
# asyncclick 8.4 gives for "kasa child" on a device without children. Ubuntu
# ships 8.3 (26.04, 26.10) and 8.1.7 (24.04), which report it differently;
# only that CLI message differs, and the rest of the suite passes.
SKIP = test_cli_child_commands
export PYBUILD_TEST_ARGS=-p no:cacheprovider $(DEB_BUILD_OPTION_PARALLEL:%=-n %) \
	-k "not ($(SKIP))" $(NOBLE_TEST_ARGS) tests

# Ubuntu 24.04's test tooling is older; none of these touch the library:
# - no pytest-socket or pytest-freezer (debian/noble-drop removes them from
#   its control file): drop the socket guard from upstream's addopts, and
#   the tests that use the freezer fixture;
# - xdoctest 1.1.3 cannot run the README's top-level "await" examples;
# - yarl there compares https://h:443/x and https://h/x unequal, which only
#   test_sslaestransport's URL assertions notice.
ifeq ($(shell dpkg-parsechangelog -SDistribution),noble)
NOBLE_TEST_ARGS = -o addopts=--dist=loadgroup \
	--ignore=tests/test_childdevice.py \
	--ignore=tests/smart/test_smartdevice.py \
	--ignore=tests/smartcam/test_smartcamdevice.py \
	--ignore=tests/test_readme_examples.py
SKIP += or test_device_closes_connection \
	or (test_sslaestransport and (test_send or test_device_500_error \
	or test_unencrypted_passthrough or test_unencrypted_response))
endif

%:
	dh $@ --buildsystem=pybuild

# Upstream marks a few modules executable; they are not scripts.
execute_after_dh_fixperms:
	find debian/python3-kasa/usr/lib/python3 -name '*.py' -perm /111 -exec chmod a-x {} +
